ined\",\"G\":[\"$1b\",[\"$L1c\"]],\"S\":true,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"1kgFVWbKVy3ypZED-VJ3X\"}\n1e:\"/_next/static/chunks/1t_5w6uypcamo.js\"\n1f:I[22016,[\"$2\",\"$3\",\"$4\",\"$5\",\"$6\",\"$1e\"],\"\"]\n2a:\"MetadataBoundary\"\n2b:I[97367,[\"$2\",\"$3\",\"$4\",\"$5\",\"$6\"],\"$2a\"]\n2c:\"$Sreact.suspense\"\n13:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$Lc\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$Ld\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n1d:T12e8,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.rajasthanvacancy.online/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Photo & Signature Resize Tool\",\"item\":\"https://www.rajasthanvacancy.online/photo-signature-resize-tool\"}]},{\"@type\":\"WebApplication\",\"name\":\"Rajasthan Vacancy Photo & Signature Resize Tool\",\"url\":\"https://www.rajasthanvacancy.online/photo-signature-resize-tool\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"All\",\"inLanguage\":[\"hi-IN\",\"en-IN\"],\"description\":\"Free browser-based Photo and Signature Resize Tool for Rajasthan RPSC, RSSB, SSO, SSC, UPSC, Railway and Banking exam forms.\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"INR\"}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"क्या यह Photo & Signature Resize Tool पूरी तरह सुरक्षित और फ्री है?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"जी हाँ, यह टूल 100% मुफ़्त है और पूरी तरह आपके मोबाइल या कंप्यूटर ब्राउज़र (HTML5 Canvas) में काम करता है। आपकी फोटो या हस्ताक्षर किसी भी बाहरी सर्वर पर अपलोड या सेव नहीं किए जाते।\"}},{\"@type\":\"Question\",\"name\":\"राजस्थान SSO / RPSC / RSSB भर्ती फॉर्म के लिए फोटो और सिग्नेचर का सही साइज़ क्या है?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"राजस्थान SSO पोर्टल (RPSC व RSSB/RSMSSB भर्तियों) के लिए पासपोर्ट फोटो का साइज़ सामान्यतः 50 KB से 100 KB (लगभग 240 × 320 पिक्सेल, 3.5 × 4.5 सेमी) और हस्ताक्षर (Signature) का साइज़ 20 KB से 50 KB (लगभग 280 × 80 पिक्सेल) JPG/JPEG फ़ॉर्मेट में होना चाहिए।\"}},{\"@type\":\"Question\",\"name\":\"SSC (CGL, CHSL, GD, MTS) फॉर्म के लिए फोटो और सिग्नेचर कितने KB का होना चाहिए?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"SSC की परीक्षाओं के लिए पासपोर्ट फोटो 20 KB से 50 KB (3.5 सेमी चौड़ाई × 4.5 सेमी ऊंचाई) और हस्ताक्षर 10 KB से 20 KB (4.0 सेमी चौड़ाई × 2.0 सेमी ऊंचाई) के बीच JPEG फ़ॉर्मेट में मांगे जाते हैं।\"}},{\"@type\":\"Question\",\"name\":\"UPSC (IAS, NDA, CDS) के लिए फोटो और सिग्नेचर का पिक्सेल साइज़ क्या होता है?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"UPSC आवेदन में फोटो और सिग्नेचर दोनों का न्यूनतम पिक्सेल 350 × 350 और अधिकतम 1000 × 1000 पिक्सेल तथा फ़ाइल साइज़ 20 KB से 300 KB के बीच JPG फ़ॉर्मेट में होना आवश्यक है।\"}},{\"@type\":\"Question\",\"name\":\"क्या मोबाइल से खींची गई सिग्नेचर फोटो का बैकग्राउंड सफ़ेद किया जा सकता है?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"हाँ, टूल में \\\"हस्ताक्षर (Signature)\\\" मोड चुनकर \\\"सफ़ेद बैकग्राउंड साफ़ करें (Clean White Signature Background)\\\" विकल्प चालू करें। इससे कागज़ की हल्की छाया हट जाएगी और आपके हस्ताक्षर साफ़ व गहरे दिखाई देंगे।\"}},{\"@type\":\"Question\",\"name\":\"क्या इस टूल से फोटो के नीचे नाम और फोटो खींचने की तारीख (DOP) लिखी जा सकती है?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"हाँ, पासपोर्ट फोटो मोड में \\\"फोटो के नीचे नाम और तारीख लिखें\\\" विकल्प चुनकर आप अभ्यर्थी का नाम और Date of Photo (DOP) सीधे फोटो के नीचे जोड़ सकते हैं।\"}}]}]}16:[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"article\",null,{\"className\":\