xt\\\":\\\"जी हाँ, यह टूल 100% मुफ़्त है और पूरी तरह आपके मोबाइल या कंप्यूटर ब्राउज़र (HTML5 Canvas) में काम करता है। आपकी फोटो या हस्ताक्षर किसी भी बाहरी सर्वर पर अपलोड या सेव नहीं किए जाते।\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"राजस्थान SSO / RPSC / RSSB भर्ती फॉर्म के लिए फोटो और सिग्नेचर का सही साइज़ क्या है?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"राजस्थान SSO पोर्टल (RPSC व RSSB/RSMSSB भर्तियों) के लिए पासपोर्ट फोटो का साइज़ सामान्यतः 50 KB से 100 KB (लगभग 240 × 320 पिक्सेल, 3.5 × 4.5 सेमी) और हस्ताक्षर (Signature) का साइज़ 20 KB से 50 KB (लगभग 280 × 80 पिक्सेल) JPG/JPEG फ़ॉर्मेट में होना चाहिए।\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"SSC (CGL, CHSL, GD, MTS) फॉर्म के लिए फोटो और सिग्नेचर कितने KB का होना चाहिए?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"SSC की परीक्षाओं के लिए पासपोर्ट फोटो 20 KB से 50 KB (3.5 सेमी चौड़ाई × 4.5 सेमी ऊंचाई) और हस्ताक्षर 10 KB से 20 KB (4.0 सेमी चौड़ाई × 2.0 सेमी ऊंचाई) के बीच JPEG फ़ॉर्मेट में मांगे जाते हैं।\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"UPSC (IAS, NDA, CDS) के लिए फोटो और सिग्नेचर का पिक्सेल साइज़ क्या होता है?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"UPSC आवेदन में फोटो और सिग्नेचर दोनों का न्यूनतम पिक्सेल 350 × 350 और अधिकतम 1000 × 1000 पिक्सेल तथा फ़ाइल साइज़ 20 KB से 300 KB के बीच JPG फ़ॉर्मेट में होना आवश्यक है।\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"क्या मोबाइल से खींची गई सिग्नेचर फोटो का बैकग्राउंड सफ़ेद किया जा सकता है?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"हाँ, टूल में \\\\\\\"हस्ताक्षर (Signature)\\\\\\\" मोड चुनकर \\\\\\\"सफ़ेद बैकग्राउंड साफ़ करें (Clean White Signature Background)\\\\\\\" विकल्प चालू करें। इससे कागज़ की हल्की छाया हट जाएगी और आपके हस्ताक्षर साफ़ व गहरे दिखाई देंगे।\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"क्या इस टूल से फोटो के नीचे नाम और फोटो खींचने की तारीख (DOP) लिखी जा सकती है?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"हाँ, पासपोर्ट फोटो मोड में \\\\\\\"फोटो के नीचे नाम और तारीख लिखें\\\\\\\" विकल्प चुनकर आप अभ्यर्थी का नाम और Date of Photo (DOP) सीधे फोटो के नीचे जोड़ सकते हैं।\\\"}}]}]}16:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"w-full space-y-8 pb-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1d\\\"}}],[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"space-y-2.5 pt-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 text-xs sm:text-sm text-slate-600\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1f\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"inline-flex items-center gap-1 text-[#15803d] font-semibold hover:underline\\\",\\\"children\\\":[\\\"$L20\\\",\\\"$L21\\\"]}],\\\"$L22\\\",\\\"$L23\\\"]}],\\\"$L24\\\",\\\"$L25\\\"]}],\\\"$L26\\\",\\\"$L27\\\"]}],[\\\"$L28\\\"],\\\"$L29\\\"]}]\\n1a:[\\\"$\\\",\\\"$L2b\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$2c\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L2d\\\"}]}],null]}]\\n1c:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/3-6dodx4ybyml.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n2e:\\\"PhotoSignResizeTool\\\"\\n2f:I[54720,[\\\"$2\\\",\\\"$3\\\",\\\"$4\\\",\\\"$5\\\",\\\"$6\\\",\\\"$1e\\\"],\\\"$2e\\\"]\\n38:I[97367,[\\\"$2\\\",\\\"$3\\\",\\\"$4\\\",\\\"$5\\\",\\\"$6\\\"],\\\"OutletBoundary\\\"]\\n14:C\\n20:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":