rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened global helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrapped admin (verified runtime email) or trusted /admins/{uid} document
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'rahulmathuriya7878@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation blueprints (Pillar 2: strict keys, type safety, boundary limits)
    function isValidCategory(cat) {
      return cat is string &&
        cat.size() >= 1 &&
        cat.size() <= 64 &&
        cat in [
          'latest_job',
          'admit_card',
          'result',
          'answer_key',
          'syllabus',
          'scheme',
          'upcoming',
          'ugc_net',
          'exam_date',
          'news'
        ];
    }

    function isValidJobPost(data, jobId) {
      return data.keys().hasAll([
          'jobId',
          'slug',
          'title',
          'titleHi',
          'category',
          'totalPosts',
          'qualification',
          'dates',
          'links',
          'description',
          'status',
          'payload',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'jobId',
          'slug',
          'title',
          'titleHi',
          'category',
          'totalPosts',
          'qualification',
          'dates',
          'links',
          'description',
          'status',
          'payload',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.jobId) &&
        data.jobId == jobId &&
        isValidId(data.slug) &&
        data.slug == jobId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 500 &&
        data.titleHi is string && data.titleHi.size() >= 1 && data.titleHi.size() <= 500 &&
        isValidCategory(data.category) &&
        data.totalPosts is string && data.totalPosts.size() >= 1 && data.totalPosts.size() <= 120 &&
        data.qualification is string && data.qualification.size() >= 1 && data.qualification.size() <= 500 &&
        data.dates is map &&
        data.dates.keys().hasOnly(['startDate', 'lastDate', 'notificationDate', 'examDate']) &&
        data.links is map &&
        data.links.keys().hasOnly(['applyOnlineUrl', 'notificationPdfUrl', 'officialWebsiteUrl']) &&
        data.description is string && data.description.size() <= 20000 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 64 &&
        data.payload is map &&
        data.updatedByUid is string &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVacancyOverride(data, vacancyId) {
      return data.keys().hasAll([
          'vacancyId',
          'isDeleted',
          'title',
          'titleHi',
          'category',
          'payload',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'vacancyId',
          'isDeleted',
          'title',
          'titleHi',
          'category',
          'payload',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.vacancyId) &&
        data.vacancyId == vacancyId &&
        data.isDeleted is bool &&
        data.title is string && data.title.size() <= 500 &&
        data.titleHi is string && data.titleHi.size() <= 500 &&
        isValidCategory(data.category) &&
        data.payload is map &&
        data.updatedByUid is string &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedVacancy(data) {
      return data.keys().hasAll(['userId', 'vacancyId', 'vacancyTitle', 'category', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'vacancyId', 'vacancyTitle', 'category', 'createdAt']) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.vacancyId) &&
        data.vacancyTitle is string && data.vacancyTitle.size() >= 1 && data.vacancyTitle.size() <= 500 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        data.createdAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp;
    }

    function isValidUserAlertPreferences(data, userId) {
      return data.keys().hasAll([
          'userId',
          'savedAlerts',
          'preferences',
          'readNotificationIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'savedAlerts',
          'preferences',
          'readNotificationIds',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.savedAlerts is list &&
        data.savedAlerts.size() <= 25 &&
        (data.savedAlerts.size() == 0 || data.savedAlerts[0] is map) &&
        data.preferences is map &&
        data.preferences.keys().hasOnly([
          'inAppEnabled',
          'inAppBannerPopup',
          'browserPushEnabled',
          'digestFrequency',
          'notifyOnStatusChange',
          'quietMode'
        ]) &&
        data.readNotificationIds is list &&
        data.readNotificationIds.size() <= 200 &&
        (
          data.readNotificationIds.size() == 0 ||
          (data.readNotificationIds[0] is string && data.readNotificationIds[0].size() <= 160)
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminTemplate(data, templateId) {
      return data.keys().hasAll([
          'templateId',
          'title',
          'titleHi',
          'content',
          'contentHi',
          'headers',
          'rows',
          'autoGenerateOnResult',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'templateId',
          'title',
          'titleHi',
          'content',
          'contentHi',
          'headers',
          'rows',
          'autoGenerateOnResult',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.templateId) &&
        data.templateId == templateId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.titleHi is string && data.titleHi.size() >= 1 && data.titleHi.size() <= 150 &&
        data.content is string && data.content.size() <= 1000 &&
        data.contentHi is string && data.contentHi.size() <= 1000 &&
        data.headers is list &&
        data.headers.size() >= 1 &&
        data.headers.size() <= 10 &&
        data.headers[0] is string &&
        data.headers[0].size() >= 1 &&
        data.headers[0].size() <= 100 &&
        data.rows is list &&
        data.rows.size() >= 1 &&
        data.rows.size() <= 50 &&
        data.rows[0] is map &&
        data.autoGenerateOnResult is bool &&
        data.updatedByUid is string &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 0. Publicly readable Jobs Collection (PostBuilderClient CRUD - zero PII, admin-only writes)
    match /jobs/{jobId} {
      allow get: if isValidId(jobId);
      allow list: if true;
      allow create: if isVerifiedUser() &&
        isValidId(jobId) &&
        isValidJobPost(incoming(), jobId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(jobId) &&
        isValidJobPost(incoming(), jobId) &&
        incoming().jobId == existing().jobId &&
        incoming().slug == existing().slug &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'titleHi',
          'category',
          'totalPosts',
          'qualification',
          'dates',
          'links',
          'description',
          'status',
          'payload',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(jobId) && isAdmin();
    }

    // 1. Publicly readable Vacancy Overrides (Word In-Place Edit Mode & Admin Deletions)
    // Contains only public job posting content (zero PII). Writes restricted strictly to verified admins.
    match /vacancy_overrides/{vacancyId} {
      allow get: if isValidId(vacancyId);
      allow list: if true;
      allow create: if isVerifiedUser() &&
        isValidId(vacancyId) &&
        isValidVacancyOverride(incoming(), vacancyId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(vacancyId) &&
        isValidVacancyOverride(incoming(), vacancyId) &&
        incoming().vacancyId == existing().vacancyId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isDeleted',
          'title',
          'titleHi',
          'category',
          'payload',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(vacancyId) && isAdmin();
    }

    // 2. Private User Profiles (PII Isolation - owner or verified admin only)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 3. Per-User Saved Vacancies (strictly owner-scoped reads & list queries)
    match /saved_vacancies/{saveId} {
      allow get: if isSignedIn() && isValidId(saveId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(saveId) &&
        isValidSavedVacancy(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(saveId) &&
        isValidSavedVacancy(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['vacancyTitle', 'category'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(saveId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 4. Trusted Admin Registry (strictly admin-managed)
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidAdminRecord(incoming(), userId) &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidAdminRecord(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin();
    }

    // 5. Per-User Saved Search Job Alerts & Notification Preferences (strictly owner-scoped)
    match /user_alert_preferences/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAlertPreferences(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAlertPreferences(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'savedAlerts',
              'preferences',
              'readNotificationIds',
              'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 6. Startup Connection Health Check (read-only single doc)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // 7. Admin-Only Persistent Post Builder Templates (e.g., Result Details)
    match /admin_templates/{templateId} {
      allow get: if isVerifiedUser() && isValidId(templateId) && isAdmin();
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(templateId) &&
        isValidAdminTemplate(incoming(), templateId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(templateId) &&
        isValidAdminTemplate(incoming(), templateId) &&
        incoming().templateId == existing().templateId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'titleHi',
          'content',
          'contentHi',
          'headers',
          'rows',
          'autoGenerateOnResult',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(templateId) && isAdmin();
    }
  }
}
