{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "NODE_ENV=production next build && NODE_ENV=production opennextjs-cloudflare build --skipNextBuild",
    "start": "next start -H 0.0.0.0 -p 3000",
    "cf:build": "NODE_ENV=production next build && NODE_ENV=production opennextjs-cloudflare build --skipNextBuild",
    "cf:preview": "npm run build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run build && opennextjs-cloudflare deploy",
    "clean": "rm -rf .next .open-next .wrangler dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4.3.5",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wrangler": "^4.166.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
